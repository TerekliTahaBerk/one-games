# OneGames runtime configuration.
#
# Copy to `.env.local` for development and set the same keys as hosted runtime
# values in production. Never commit real secrets.
#
# Nothing here is required to run the app or the tests: with these unset, the
# email and checkout steps report that they are not connected and the
# "Test this game" path stays fully functional. No integration is ever
# simulated as if it had succeeded.

# --- Email verification ------------------------------------------------------
# HMAC key for six-digit code hashing. Any long random string; rotating it
# invalidates every outstanding code. Required for /api/access/request-code.
EMAIL_VERIFICATION_SECRET=

# Resend API key used to deliver verification codes.
RESEND_API_KEY=

# Verified Resend sender for those codes.
ONEGAMES_EMAIL_FROM=OneGames <hello@oneread.email>

# --- Billing (Polar) ---------------------------------------------------------
# Organization access token used to open checkout sessions.
POLAR_ACCESS_TOKEN=

# The $1/month OneGames product.
POLAR_ONEGAMES_PRODUCT_ID=

# Signing secret for the Polar webhook. Without it the webhook returns 503 and
# no subscription can reach `active`.
POLAR_WEBHOOK_SECRET=

# `sandbox` or `production`.
POLAR_SERVER=sandbox

# --- Site --------------------------------------------------------------------
# Canonical public origin. Used for checkout return URLs, the sitemap, and
# robots.txt.
PUBLIC_BASE_URL=http://localhost:3000
